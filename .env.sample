# Neon Postgres (pooled URL for runtime; direct URL for migrations — see Neon dashboard)
# Prisma CLI does not load .env.local. Put DATABASE_URL here or use: pnpm db:generate / pnpm db:migrate:dev / pnpm db:migrate
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# Resend (compliance email after on-chain pay — see docs/INFRA_RECOMMENDATIONS.md)
# API key from https://resend.com — COMPLIANCE_EMAIL_FROM must be a verified domain (or Resend trial sender).
RESEND_API_KEY=""
COMPLIANCE_EMAIL_FROM=""
# Production / staging: Ridivi inbox. (Local compliance email only: pnpm test:email-compliance → wldasinpe@gmail.com)
COMPLIANCE_EMAIL_TO=""

AUTH_SECRET="" # Added by `npx auth secret`. Read more: https://cli.authjs.dev
HMAC_SECRET_KEY='some-secret' # create this by running `openssl rand -base64 32`
AUTH_URL='' # For testing this should be your NGROK URL and for production this should be your production URL
NEXT_PUBLIC_APP_ID='app_1234567890' # Developer Portal app id (required with compliance email — also used as Get Transaction ?app_id=)
# Optional: Bearer token for developer.world.org (Get Transaction does not require it in current OpenAPI).
WORLD_DEVELOPER_API_KEY=''
# Optional: WLD ERC-20 on World Chain (defaults to address book mainnet token)
NEXT_PUBLIC_WLD_TOKEN_ADDRESS=''
# Optional: preferred World Chain HTTP RPC for server reads (tried first; then Thirdweb/dRPC fallbacks)
WORLDCHAIN_RPC_URL=''

# Pricing (client-visible; used by withdraw UI and initiate-payment). No hardcoded rates in code.
# Option A — effective CRC per 1 WLD:
NEXT_PUBLIC_WLD_TO_CRC='198'
# Option B — instead of WLD_TO_CRC, set both (CRC per WLD = product):
# NEXT_PUBLIC_WLD_TO_USD='0.4'
# NEXT_PUBLIC_USD_TO_CRC='495'
# Fee in CRC (fixed per withdrawal):
NEXT_PUBLIC_COMISION_CRC='495'
# Or fee from USD × USD_TO_CRC (requires NEXT_PUBLIC_USD_TO_CRC):
# NEXT_PUBLIC_FLAT_FEE_USD='1'
# NEXT_PUBLIC_USD_TO_CRC='495'

# Ridivi SINPE Móvil (server-only; used by /api/sinpe/validate-phone)
RIDIVI_API_BASE_URL=''
RIDIVI_API_KEY=''
RIDIVI_API_SECRET=''